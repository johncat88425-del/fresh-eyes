            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Queue a reviewed functional run or an explicitly enabled bounded GitHub startup check",
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
