{
  "openapi": "3.1.0",
  "info": {
    "title": "Fresh Eyes local teammate API",
    "version": "0.2.1",
    "description": "Loopback API, models disabled by default. An explicitly owner-armed fixed development plan may run once through the queue. HTTP clients cannot change its budget, sources, models or reviews. Live PyPI uses an isolated PyPI-only proxy. Explicitly enabled public GitHub startup checks support bounded Python CLI README installation and help/version commands without model calls or functional acceptance. Sandboxes and nightly checks remain unimplemented."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Actual backend capabilities",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "403": {
            "description": "See api/README.md for error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/cases": {
      "get": {
        "summary": "Pinned registered acceptance contracts",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "schema_version": {
                      "const": 1
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Case"
                      }
                    }
                  },
                  "required": [
                    "schema_version",
                    "items"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "See api/README.md for error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/cases/{case_id}/approval": {
      "post": {
        "summary": "Record team acceptance review for the exact current hash",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Case"
