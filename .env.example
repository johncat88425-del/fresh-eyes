# Not needed for the deterministic local prototype. Never commit a real key.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Select an NVIDIA model from your authenticated model catalog.
NEBIUS_MODEL=
# Sandboxes uses the same project's key plus its Project settings identifier.
# Optional: only scripts/fresh-eyes sandboxes-doctor --env-file .env reads these.
NEBIUS_PROJECT_ID=
TAVILY_API_KEY=
