    "/api/runs/{run_id}": {
      "get": {
        "summary": "Persisted run and raw evidence",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "403": {
            "description": "See api/README.md for error codes.",
            "content": {
