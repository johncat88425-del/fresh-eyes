                }
              }
            }
          },
          "404": {
            "description": "See api/README.md for error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/openapi.json": {
      "get": {
        "summary": "This interface contract",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "See api/README.md for error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/cases/{case_id}/approval/history": {
      "get": {
        "operationId": "approvalHistory",
        "summary": "Read append-only team approval history",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "History with revisions, attribution and migration notice"
          },
          "404": {
            "description": "Unknown case"
          }
        }
      }
    },
    "/api/cases/{case_id}/approval/correction": {
      "post": {
        "operationId": "correctApproval",
        "summary": "Explicit attributed correction; preserves old approval and timestamp",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "acceptance_sha256",
                  "reviewed_by",
                  "corrected_by",
                  "reason",
                  "expected_revision"
                ],
                "properties": {
                  "acceptance_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "reviewed_by": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "corrected_by": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "expected_revision": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Case with new review revision"
          },
          "400": {
            "description": "Reason, author or revision missing, or reviewer unchanged"
          },
          "404": {
            "description": "Case or approval missing"
          },
          "409": {
            "description": "Acceptance/revision changed"
          }
        }
      }
    },
    "/api/repo-inspections": {
      "post": {
        "summary": "Queue bounded public source/README inspection; never runs repository commands or calls a model",
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "400": {
            "description": "See api/README.md for error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "See api/README.md for error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "See api/README.md for error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "See api/README.md for error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "See api/README.md for error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "See api/README.md for error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "See api/README.md for error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "501": {
            "description": "See api/README.md for error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "See api/README.md for error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RepoInspectionRequest"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Costs": {
        "type": "object",
        "properties": {
          "currency": {
            "const": "USD"
          },
          "model_calls": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "model_usd": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "runner_usd": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "billing_status": {
            "type": "string"
          },
          "paid_calls_enabled": {
            "const": false
          }
        },
        "required": [
          "currency",
          "model_calls",
          "model_usd",
          "runner_usd",
          "billing_status",
          "paid_calls_enabled"
        ],
        "additionalProperties": false
      },
      "Review": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "approved",
              "development_reviewed",
              "draft",
              "example"
            ]
          },
          "reviewed_by": {
            "type": "string"
          },
          "approved_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "acceptance_sha256": {
            "type": "string"
          },
          "review_revision": {
            "type": "integer",
            "minimum": 1,
            "description": "Monotonic approval revision; required for explicit corrections"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": true
      },
      "Fixture": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "input": {
            "type": "string"
          },
          "validator": {
            "enum": [
              "text",
              "json",
              "html_elements",
              "text_lines"
            ]
          },
          "expected": {}
        },
        "required": [
          "name",
          "input",
          "validator",
          "expected"
        ],
        "additionalProperties": false
      },
      "Case": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string"
          },
          "data_origin": {
            "const": "registered_contract"
          },
          "repo_url": {
            "type": "string",
            "format": "uri"
          },
          "commit_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "goal": {
            "type": "string"
          },
          "readme_source": {
            "type": "string"
          },
          "environment": {
            "type": "object"
          },
          "acceptance_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "contract_sha256": {
            "type": "string"
          },
          "review": {
            "$ref": "#/components/schemas/Review"
          },
          "upstream_maintainer_approval": {
            "const": false
          },
          "fixtures": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/components/schemas/Fixture"
            }
          },
          "manual_candidate_available": {
            "type": "boolean"
          },
          "execution_enabled": {
            "type": "boolean"
          },
          "can_run": {
            "type": "boolean"
          }
        },
        "required": [
          "case_id",
          "data_origin",
          "repo_url",
          "commit_sha",
          "goal",
          "readme_source",
          "environment",
          "acceptance_sha256",
          "contract_sha256",
          "review",
          "upstream_maintainer_approval",
          "fixtures",
          "manual_candidate_available",
          "execution_enabled",
          "can_run"
        ],
        "additionalProperties": false
      },
      "Run": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": 1
          },
          "run_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "data_origin": {
            "enum": [
              "execution",
              "example",
              "inspection"
            ]
          },
          "case_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "repo_url": {
            "type": "string",
            "format": "uri"
          },
          "commit_sha": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{40}$"
          },
          "verification_level": {
            "enum": [
              "startup",
              "functional"
            ]
          },
          "acceptance_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "review": {
            "$ref": "#/components/schemas/Review"
          },
          "repair_mode": {
            "enum": [
              "none",
              "manual_candidate",
              "model"
            ]
          },
          "repair_author": {
            "type": [
              "string",
              "null"
            ]
          },
          "run_state": {
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ]
          },
          "result_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "already_passes",
              "verified_fix",
              "startup_only",
              "needs_review",
              "needs_input",
              "unsupported",
              "unresolved",
              "infrastructure_error",
              null
            ]
          },
          "phase": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "patch_available": {
            "type": "boolean"
          },
          "costs": {
            "$ref": "#/components/schemas/Costs"
          },
          "evidence": {
