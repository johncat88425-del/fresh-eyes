            }
          },
          "404": {
            "description": "See api/README.md for error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/runs/{run_id}/patch": {
      "get": {
        "summary": "Download an actual candidate diff; inspect run.result_status for verification",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Actual patch, possibly unverified",
            "content": {
              "text/x-diff": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "No such run or no actual patch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Loopback/origin required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/examples": {
      "get": {
        "summary": "Static examples, never actual executions",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data_origin": {
                      "const": "example"
                    },
                    "executed": {
                      "const": false
                    },
                    "items": {
                      "type": "object",
                      "additionalProperties": {
                        "$ref": "#/components/schemas/Run"
                      }
                    }
                  },
                  "required": [
                    "data_origin",
                    "executed",
                    "items"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "See api/README.md for error codes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/examples/{name}": {
      "get": {
        "summary": "One labelled example",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "403": {
            "description": "See api/README.md for error codes.",
            "content": {
